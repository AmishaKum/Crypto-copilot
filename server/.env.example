# Copy to server/.env  (never commit .env)
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas free M0 cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crypto-copilot
# Used from Step 2 (auth): long random string
JWT_SECRET=change-me-to-a-64-char-random-string
# Used from Step 4 (AI assistant)
AI_API_KEY=
