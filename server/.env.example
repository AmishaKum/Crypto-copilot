# Copy to server/.env and fill in. NEVER commit server/.env.
PORT=5000
# Comma-separated list of allowed frontend origins (exact match, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include a database name, e.g. /crypto-copilot
MONGODB_URI=
# Long random secret (32+ chars). PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=
# lax for local dev; none when the frontend and API are on different domains in production (requires HTTPS)
COOKIE_SAMESITE=lax
# Comma-separated emails that get the admin dashboard when they register or log in
ADMIN_EMAILS=
# Optional free CoinGecko Demo API key (recommended; raises rate limits). Get one at coingecko.com/en/api
COINGECKO_API_KEY=
# AI assistant (optional). Provider: gemini (free tier available) or anthropic
AI_PROVIDER=gemini
AI_API_KEY=
# Optional model override (e.g. a current Gemini Flash model from aistudio.google.com).
# Default: gemini-flash-latest; if a Gemini model name is retired the server auto-picks a current Flash model.
AI_MODEL=
# Server-wide cap on AI questions per day (protects free-tier quotas)
AI_DAILY_LIMIT=200
# How often in-app alerts are evaluated (ms)
ALERTS_INTERVAL_MS=120000
# Simulated trading fee in basis points (10 = 0.10%)
TRADE_FEE_BPS=10

# ---- Email (password reset + alert emails) ----
# Leave SMTP_HOST empty to print emails (including reset links) in the server terminal instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<Brevo SMTP login>, SMTP_PASS=<Brevo SMTP key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Crypto Copilot <you@gmail.com>
# Public URL of the frontend, used in email links (defaults to the first CLIENT_ORIGIN)
APP_URL=http://localhost:5173
